// Hardened ESLint flat-config example.
//
// This file is intentionally a TEMPLATE: adapt source roots, runtime globals,
// import boundaries and local rule options before use. The default severities
// below are conservative for an unknown codebase; measure the baseline.

import js from "@eslint/js";
import { defineConfig, globalIgnores } from "eslint/config";
import { createTypeScriptImportResolver } from "eslint-import-resolver-typescript";
import importX from "eslint-plugin-import-x";
import tseslint from "typescript-eslint";

import quality from "./eslint-rules/index.cjs";

const SOURCE = "src/**/*.{js,jsx,ts,tsx,mjs,cjs}";
const TESTS = [
  "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}",
  "**/{__tests__,__mocks__,fixtures,mocks}/**/*.{js,jsx,ts,tsx,mjs,cjs}",
];

export default defineConfig([
  js.configs.recommended,
  ...tseslint.configs.strict,

  {
    languageOptions: {
      parserOptions: { tsconfigRootDir: import.meta.dirname },
      globals: {
        console: "readonly",
        process: "readonly",
        fetch: "readonly",
        URL: "readonly",
        setTimeout: "readonly",
        clearTimeout: "readonly",
      },
    },
  },

  {
    plugins: { "import-x": importX, "import-x-debt": importX },
    settings: {
      "import-x/resolver-next": [createTypeScriptImportResolver()],
    },
    rules: {
      "import-x/no-unresolved": "error",
      "import-x/no-duplicates": "error",
      // Replace these example zones with invariants that actually exist.
      "import-x/no-restricted-paths": [
        "error",
        {
          zones: [
            { target: "./src/app/**/*", from: "./src/db/index.ts" },
          ],
        },
      ],
      // Put pre-existing boundary debt here as warn; move to the blocking key
      // after the baseline reaches zero and the boundary is still intentional.
      "import-x-debt/no-restricted-paths": ["warn", { zones: [] }],
    },
  },

  {
    files: [SOURCE],
    plugins: { quality },
    rules: {
      "no-empty": ["error", { allowEmptyCatch: true }],
      "no-var": "error",
      "prefer-const": "error",
      "@typescript-eslint/no-unused-vars": [
        "error",
        { argsIgnorePattern: "^_", varsIgnorePattern: "^_" },
      ],

      // Advisory maintenance signals. Keep them warnings unless the project
      // explicitly decides a particular metric must be a blocking invariant.
      complexity: ["warn", 12],
      "max-depth": ["warn", 4],
      "max-statements": ["warn", 20],
      "max-params": ["warn", 4],
      "max-lines-per-function": [
        "warn",
        { max: 150, skipBlankLines: true, skipComments: true },
      ],
      "max-nested-callbacks": ["warn", 3],

      // 350 is a cohesion-review budget, not an automatic architectural law.
      // Use ignore:[...] only for narrow, documented cohesive exceptions.
      "quality/max-lines": ["warn", { max: 350 }],

      "quality/no-direct-console": [
        "error",
        { logger: "the project logging helper" },
      ],
      "quality/no-direct-data-access": [
        "error",
        {
          modules: ["@/db", "@/db/index"],
          bindings: ["db"],
          layers: ["/src/app/", "/src/components/"],
          extensions: [".jsx", ".tsx"],
        },
      ],
    },
  },

  {
    files: TESTS,
    plugins: { quality },
    rules: {
      "max-statements": "off",
      "max-lines-per-function": "off",
      "max-nested-callbacks": "off",
      "quality/max-lines": ["warn", { max: 350, includeTests: true }],
      "import-x/no-restricted-paths": "off",
      "import-x-debt/no-restricted-paths": "off",
    },
  },

  {
    files: ["eslint-rules/**/*.cjs"],
    languageOptions: {
      sourceType: "commonjs",
      globals: { module: "readonly", require: "readonly" },
    },
    rules: {
      "@typescript-eslint/no-require-imports": "off",
    },
  },

  globalIgnores([
    ".claude/**",
    ".github/agents/**",
    ".github/hooks/**",
    ".github/skills/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "**/*.tsbuildinfo",
    "src/generated/**",
  ]),
]);
