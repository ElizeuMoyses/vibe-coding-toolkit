// Defensive hook I/O helpers.
// JSON.parse can successfully return null, arrays, strings, numbers or booleans.
// A hook event must be an object record before callers may access properties.

import { readFileSync } from "node:fs";

export function readStdinRaw() {
  try {
    return readFileSync(0, "utf8");
  } catch {
    return "";
  }
}

export function parseHookEvent(raw) {
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    return null;
  }

  if (
    parsed === null ||
    typeof parsed !== "object" ||
    Array.isArray(parsed)
  ) {
    return null;
  }

  return parsed;
}

// Usage:
// const event = parseHookEvent(readStdinRaw());
//
// IMPORTANT: choose the failure policy at the call site.
// - Optional/enrichment hook: malformed input may fail open (exit 0).
// - Security/enforcement hook: malformed or incomplete input must fail closed
//   using the blocking mechanism documented by that harness.
//
// After parsing, validate the fields the hook actually requires, e.g.:
// const toolName = typeof event?.tool_name === "string" ? event.tool_name : null;
